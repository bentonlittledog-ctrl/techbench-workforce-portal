<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hours per repair - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Hours per repair</h1>
    <p class="sub">Each shift's hours are shared among the tickets that person worked on (notes, status changes, photos, parts) while clocked in. It is an estimate, not a stopwatch.</p>
    <div class="rangebar">
        <% [['30','30 days'],['90','90 days'],['365','Year'],['all','All time']].forEach(r => { %><a class="<%= range === r[0] ? 'on' : '' %>" href="/bench/hours?range=<%= r[0] %>"><%= r[1] %></a><% }) %>
    </div>
    <div class="panel"><h3>By tier</h3>
        <div class="table-wrap"><table><thead><tr><th>Tier</th><th class="num">Tickets</th><th class="num">Avg hours each</th><th class="num">Total hours</th></tr></thead>
        <tbody><% tierRows.forEach(r => { %><tr><td><%= r.label %></td><td class="num"><%= r.tickets %></td><td class="num"><%= r.avg == null ? '-' : r.avg %></td><td class="num"><%= r.total == null ? '-' : r.total %></td></tr><% }) %></tbody></table></div>
    </div>
    <div class="panel"><h3>By person</h3>
        <% if (!people.length) { %><p class="hint">No finished shifts in this range.</p><% } else { %>
        <div class="table-wrap"><table><thead><tr><th>Person</th><th class="num">Hours clocked</th><th class="num">On tickets</th><th class="num">Share</th><th class="num">Tickets touched</th></tr></thead>
        <tbody><% people.forEach(p => { %><tr><td><%= p.name %></td><td class="num"><%= p.shift %></td><td class="num"><%= p.onTickets %></td><td class="num"><%= p.share %>%</td><td class="num"><%= p.tickets %></td></tr><% }) %></tbody></table></div>
        <p class="hint">"Share" is how much of their clocked time shows up as ticket work. A low share is normal for shifts spent on shelving, inventory or training.</p>
        <% } %>
    </div>
    <div class="panel"><h3>Most hours on one ticket</h3>
        <% if (!top.length) { %><p class="hint">Nothing yet.</p><% } else { %>
        <div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Device</th><th>Tier</th><th>Status</th><th>Assigned</th><th class="num">Hours</th></tr></thead>
        <tbody><% top.forEach(t => { %><tr><td><a href="/bench/ticket?id=<%= t.id %>">#<%= t.id %></a></td><td><%= t.model %></td><td><%= t.tier %></td><td><%= t.status %></td><td><%= t.who || '-' %></td><td class="num"><%= t.hours %></td></tr><% }) %></tbody></table></div>
        <% } %>
    </div>
</body>
</html>
