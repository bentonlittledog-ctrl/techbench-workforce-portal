<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audit log - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Audit log</h1>
    <p class="sub">Every timecard change: who made it, which employee, what changed, and why. Showing the latest 300.</p>
    <div class="table-wrap">
    <table>
        <thead><tr><th>When</th><th>Changed by</th><th>Employee</th><th>Type</th><th>What changed</th><th>Reason</th></tr></thead>
        <tbody>
            <% rows.forEach(r => { %>
                <tr>
                    <td class="mono"><%= r.when %></td>
                    <td><%= r.actor_name %></td>
                    <td><%= r.target_name %></td>
                    <td><span class="badge <%= /DELETE|REMOVE/.test(r.action) ? 'bad' : (/ADD/.test(r.action) ? 'ok' : '') %>"><%= r.action.replace(/_/g, ' ').toLowerCase() %></span></td>
                    <td><%= r.details %></td>
                    <td><%= r.reason %></td>
                </tr>
            <% }) %>
            <% if (!rows.length) { %><tr><td colspan="6" class="empty">No changes have been made yet.</td></tr><% } %>
        </tbody>
    </table>
    </div>
</body>
</html>
