<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guide reports - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Guide reports</h1>
    <p class="sub"><a href="/learn">&larr; Learn</a> &nbsp; Problems people found in the guides. Fix the guide (or tell the student why it's right), then mark the report fixed.</p>
    <% if (flash) { %><div class="msg <%= flash.bad ? 'bad' : 'ok' %>" role="status"><%= flash.msg %></div><% } %>

    <div class="panel">
        <h3>Open (<%= open.length %>)</h3>
        <% if (!open.length) { %><p class="hint">Nothing waiting.</p><% } %>
        <% open.forEach(r => { %>
        <div class="rep">
            <div><a href="/learn/guide?id=<%= r.guide_id %>"><strong><%= r.title %></strong></a><% if (r.device_name) { %> <span class="hint"><%= r.device_name %></span><% } %></div>
            <p class="rmsg"><%= r.message %></p>
            <div class="hint"><%= r.name || 'Someone' %> &middot; <%= r.when %> UTC</div>
            <form action="/learn/reports/resolve" method="POST" class="actions"><input type="hidden" name="id" value="<%= r.id %>">
                <a class="btn-link" href="/learn/edit?id=<%= r.guide_id %>">Edit the guide</a><button type="submit">Mark fixed</button></form>
        </div>
        <% }) %>
    </div>

    <% if (closed.length) { %>
    <div class="panel">
        <h3>Recently fixed</h3>
        <% closed.forEach(r => { %>
        <div class="rep done">
            <div><a href="/learn/guide?id=<%= r.guide_id %>"><%= r.title %></a><% if (r.device_name) { %> <span class="hint"><%= r.device_name %></span><% } %></div>
            <p class="rmsg"><%= r.message %></p>
            <div class="hint"><%= r.name || 'Someone' %> &middot; fixed <%= r.done %><%= r.resolved_by ? ' by ' + r.resolved_by : '' %></div>
            <form action="/learn/reports/resolve" method="POST"><input type="hidden" name="id" value="<%= r.id %>"><button type="submit" class="btn-ghost">Reopen</button></form>
        </div>
        <% }) %>
    </div>
    <% } %>
<style>
.rep{padding:12px 0;border-bottom:1px solid var(--line)}.rep:last-child{border-bottom:0}
.rmsg{white-space:pre-wrap;margin:6px 0}.rep.done{opacity:.8}.rep form{margin-top:8px}
</style>
</body>
</html>
