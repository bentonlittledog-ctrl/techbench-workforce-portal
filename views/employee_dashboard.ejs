<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Welcome back, <%= name %></h1>
    <p class="sub">Your hours for the current pay period.</p>

    <% if (error) { %><div class="msg bad" role="alert"><%= error %></div><% } %>

    <div class="clock <%= currentStatus === 'CLOCK_IN' ? 'on' : '' %>" id="clock" <% if (typeof sinceMs !== 'undefined' && sinceMs && currentStatus === 'CLOCK_IN') { %>data-since="<%= sinceMs %>"<% } %>>
        <div>
            <div class="state"><span class="dot"></span><span><%= currentStatus === 'CLOCK_IN' ? 'On the clock' : 'Off the clock' %></span></div>
            <div class="t" id="clockTime"><%= currentStatus === 'CLOCK_IN' ? '00:00:00' : '--:--:--' %></div>
            <div class="since"><%= currentStatus === 'CLOCK_IN' ? 'Time on this shift' : 'Press Clock in when your shift starts' %></div>
        </div>
        <form action="/punch" method="POST">
            <button type="submit" name="action" value="CLOCK_IN" class="btn btn-ok" <%= currentStatus === 'CLOCK_IN' ? 'disabled' : '' %>>Clock in</button>
            <button type="submit" name="action" value="CLOCK_OUT" class="btn btn-danger" <%= currentStatus === 'CLOCK_OUT' ? 'disabled' : '' %>>Clock out</button>
        </form>
    </div>

    <div class="stats">
        <div class="stat"><div class="k">Hourly rate</div><div class="v">$<%= rate %><small>/hr</small></div></div>
        <div class="stat"><div class="k">Hours this period</div><div class="v"><%= totalHours %><small> hrs</small></div></div>
        <div class="stat"><div class="k">Estimated gross pay</div><div class="v">$<%= totalPayout %></div></div>
    </div>

    <h3>Punch history</h3>
    <div class="table-wrap">
    <table>
        <thead><tr><th>Date</th><th>Time</th><th class="num">Hours</th><th class="num">Amount</th></tr></thead>
        <tbody>
            <% shifts.forEach(shift => { %>
                <tr>
                    <td><%= shift.date %></td>
                    <td class="mono"><%= shift.time %></td>
                    <td class="num"><%= shift.hours %></td>
                    <td class="num">$<%= shift.amount %></td>
                </tr>
            <% }) %>
            <% if (!shifts.length) { %><tr><td colspan="4" class="empty">No completed shifts yet this period. Clock in to start one.</td></tr><% } %>
        </tbody>
        <tfoot><tr><td colspan="2">Total</td><td class="num"><%= totalHours %></td><td class="num">$<%= totalPayout %></td></tr></tfoot>
    </table>
    </div>

    <% if (typeof archives !== 'undefined' && archives && Object.keys(archives).length) { %>
        <h3>Archived pay periods</h3>
        <% Object.keys(archives).forEach(label => { %>
            <details class="panel">
                <summary><%= label %></summary>
                <div class="table-wrap" style="margin:0;">
                <table>
                    <thead><tr><th>Date</th><th>Time</th><th class="num">Hours</th><th class="num">Amount</th></tr></thead>
                    <tbody>
                        <% archives[label].forEach(s => { %>
                            <tr><td><%= s.date %></td><td class="mono"><%= s.time %></td><td class="num"><%= s.hours %></td><td class="num">$<%= s.amount %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
                </div>
            </details>
        <% }) %>
    <% } %>

    <script>
        (function () {
            var box = document.getElementById("clock");
            var since = Number(box.getAttribute("data-since"));
            if (!since) return;
            var out = document.getElementById("clockTime");
            function p(n) { return String(n).padStart(2, "0"); }
            function tick() {
                var s = Math.max(0, Math.floor((Date.now() - since) / 1000));
                out.textContent = p(Math.floor(s / 3600)) + ":" + p(Math.floor(s % 3600 / 60)) + ":" + p(s % 60);
            }
            tick(); setInterval(tick, 1000);
        })();
    </script>
</body>
</html>
