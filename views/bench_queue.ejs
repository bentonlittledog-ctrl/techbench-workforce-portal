<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Repair queue - Timecard Portal</title>
    <%- headTags %>
    <style>.qtabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}.qtabs .chip.on{border-color:var(--accent);background:var(--accent-soft);font-weight:600}
        td.cmp{max-width:320px}.dim{color:var(--muted)}.hi{font-weight:700;color:var(--bad)}tr.rowlink{cursor:pointer}tr.rowlink:hover{background:var(--accent-soft)}
        .two{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:560px){.two{grid-template-columns:1fr}}
        .fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:4px 14px;margin:6px 0 14px}.filters summary{cursor:pointer;font-weight:600}</style>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Repair queue</h1>
    <p class="sub">Every repair logged with the Repair Logger lands here as an active ticket. Open one to update its status, add notes or assign it.</p>

    <% if (flash) { %><div class="msg <%= flash.bad ? 'bad' : 'ok' %>" role="status"><%= flash.msg %></div><% } %>

    <div class="qtabs">
        <% [['active','Active Tickets'],['mine','Assigned to me'],['parts','Awaiting Parts'],['ready','Repaired / RFP'],['closed','Closed Tickets'],['all','All']].forEach(v => { %>
            <a class="chip<%= view === v[0] ? ' on' : '' %>" href="/bench/queue?view=<%= v[0] %><%= qs ? '&' + qs : '' %>"><%= v[1] %> <span class="n<%= count[v[0]] ? '' : ' zero' %>"><%= count[v[0]] %></span></a>
        <% }) %>
    </div>

    <form class="panel filters" action="/bench/queue" method="GET">
        <input type="hidden" name="view" value="<%= view %>">
        <div class="searchbar" style="margin-bottom:0">
            <input type="search" name="q" value="<%= f.q %>" placeholder="Search student, ID, model, serial, complaint" aria-label="Search tickets">
            <button type="submit">Search</button>
        </div>
        <details <%= (activeFilters - (f.q ? 1 : 0)) > 0 || f.sort !== 'priority' && f.sort !== 'newest' ? 'open' : '' %> style="margin-top:12px">
            <summary>Filters &amp; sorting<%= activeFilters ? ' (' + activeFilters + ' active)' : '' %></summary>
            <div class="fgrid">
                <div><label for="fs">Status</label>
                    <select id="fs" name="status"><option value="">Any status</option><% statuses.forEach(s => { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
                <div><label for="fa">Assigned to</label>
                    <select id="fa" name="assignee"><option value="">Anyone</option><option value="none" <%= f.assignee === 'none' ? 'selected' : '' %>>Unassigned</option>
                        <option value="me" <%= f.assignee === 'me' ? 'selected' : '' %>>Me</option>
                        <% people.forEach(p => { if (p.id !== me) { %><option value="<%= p.id %>" <%= f.assignee === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% } }) %></select></div>
                <div><label for="fp">Priority</label>
                    <select id="fp" name="priority"><option value="">Any</option><% priorities.forEach(p => { %><option <%= f.priority === p ? 'selected' : '' %>><%= p %></option><% }) %></select></div>
                <div><label for="fm">Device model</label>
                    <select id="fm" name="model"><option value="">Any model</option><% models.forEach(m => { %><option <%= f.model === m ? 'selected' : '' %>><%= m %></option><% }) %></select></div>
                <div><label for="ff">Opened on or after</label><input type="date" id="ff" name="from" value="<%= f.from %>"></div>
                <div><label for="ft">Opened on or before</label><input type="date" id="ft" name="to" value="<%= f.to %>"></div>
                <div><label for="fo">Sort by</label>
                    <select id="fo" name="sort"><% Object.keys(sorts).forEach(k => { %><option value="<%= k %>" <%= f.sort === k ? 'selected' : '' %>><%= sorts[k] %></option><% }) %></select></div>
            </div>
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <button type="submit" style="margin:0">Apply</button>
                <a href="/bench/queue?view=<%= view === 'all' && f.status ? 'active' : view %>">Clear filters</a>
            </div>
            <% if (f.status) { %><p class="hint" style="margin:10px 0 0">Choosing a status searches all tickets, whichever tab you were on.</p><% } %>
        </details>
    </form>

    <p class="dim" style="margin:0 0 10px"><%= total %> ticket<%= total === 1 ? '' : 's' %><%= total > rows.length ? ' (showing the first ' + rows.length + ')' : '' %></p>

    <div class="panel">
        <% if (!rows.length) { %>
            <p class="hint">No tickets here<%= activeFilters ? ' match your search or filters' : ' right now' %>.</p>
        <% } else { %>
        <div style="overflow-x:auto">
        <table>
            <thead><tr><th>#</th><th>Student</th><th>Device</th><th>Serial / asset ID</th><th>Chief complaint</th><th>Status</th><th>Assigned</th><th>Age</th></tr></thead>
            <tbody>
            <% rows.forEach(t => { %>
                <tr class="rowlink" onclick="location.href='/bench/ticket?id=<%= t.id %>'">
                    <td><a href="/bench/ticket?id=<%= t.id %>"><%= t.id %></a></td>
                    <td><%= t.student || '—' %></td>
                    <td><strong><%= t.model %></strong><% if (t.priority === 'High') { %> <span class="hi">&bull; High</span><% } %></td>
                    <td><%= t.serial || '—' %></td>
                    <td class="cmp"><%= t.complaint ? (t.complaint.length > 90 ? t.complaint.slice(0, 90) + '…' : t.complaint) : '—' %></td>
                    <td><span class="badge <%= t.tone %>"><%= t.status %></span></td>
                    <td><%= t.assigned_name || '—' %></td>
                    <td class="dim"><%= t.age === 0 ? 'Today' : t.age + 'd' %></td>
                </tr>
            <% }) %>
            </tbody>
        </table>
        </div>
        <% } %>
    </div>

    <details class="panel">
        <summary><strong>New ticket</strong> <span class="dim">&mdash; for a device that was not logged through the form</span></summary>
        <form action="/bench/queue/new" method="POST">
            <div class="two">
                <div><label for="nf">Student first name</label><input type="text" id="nf" name="student_first" maxlength="40" required autocomplete="off"></div>
                <div><label for="nl">Student last name</label><input type="text" id="nl" name="student_last" maxlength="40" required autocomplete="off"></div>
            </div>
            <div class="two">
                <div><label for="ni">Student ID number</label><input type="text" id="ni" name="student_id" maxlength="20" required autocomplete="off" inputmode="numeric"></div>
                <div><label for="ng">Grade</label><select id="ng" name="student_grade" required><option value="">Choose&hellip;</option><% grades.forEach(g => { %><option><%= g %></option><% }) %></select></div>
            </div>
            <label for="nm">Device model</label>
            <input type="text" id="nm" name="model" list="devlist" maxlength="120" required autocomplete="off">
            <datalist id="devlist"><% devices.forEach(d => { %><option value="<%= d %>"><% }) %></datalist>
            <label for="ns">Serial number / asset ID</label>
            <input type="text" id="ns" name="serial" maxlength="40" autocomplete="off">
            <label for="nc">Chief complaint</label>
            <textarea id="nc" name="complaint" maxlength="600" required></textarea>
            <label for="np">Priority</label>
            <select id="np" name="priority"><option>Normal</option><option>High</option></select>
            <button type="submit">Create ticket</button>
        </form>
    </details>
</body>
</html>
