<style>
  .topnav { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 10px 0; border-bottom: 1px solid #455a64; margin-bottom: 20px; }
  .topnav .brand { font-weight: bold; font-size: 1.05em; }
  .topnav ul { list-style: none; display: flex; gap: 6px; margin: 0; padding: 0; flex-wrap: wrap; }
  .topnav li { margin: 0; padding: 0; }
  .topnav a { padding: 8px 12px; border-radius: 6px; text-decoration: none; display: inline-block; }
  .topnav a:hover, .topnav a.active { background: #202b36; }
  .topnav .signout { color: #ff8a8a; }
  .topnav #navToggle { display: none; }
  .topnav .burger { display: none; cursor: pointer; padding: 8px 12px; border: 1px solid #455a64; border-radius: 6px; user-select: none; }
  @media (max-width: 760px) {
    .topnav .burger { display: inline-block; }
    .topnav ul { display: none; width: 100%; flex-direction: column; }
    .topnav #navToggle:checked ~ ul { display: flex; }
  }
</style>
<nav class="topnav">
  <span class="brand">Timecard Portal<% if (nav && nav.name) { %> &middot; <%= nav.name %><% } %></span>
  <input type="checkbox" id="navToggle">
  <label for="navToggle" class="burger">&#9776; Menu</label>
  <ul>
    <li><a href="/dashboard" class="<%= nav.path === '/dashboard' ? 'active' : '' %>">Dashboard</a></li>
    <% if (nav.admin) { %>
      <li><a href="/admin/requests" class="<%= nav.path.indexOf('/admin/requests') === 0 ? 'active' : '' %>">Pending requests</a></li>
    <% } else { %>
      <li><a href="/requests/new" class="<%= nav.path.indexOf('/requests') === 0 ? 'active' : '' %>">Request missed hours</a></li>
    <% } %>
    <li><a href="/timecards" class="<%= nav.path === '/timecards' ? 'active' : '' %>">Past timecards</a></li>
    <% if (nav.admin) { %>
      <li><a href="/admin/users/reset" class="<%= nav.path === '/admin/users/reset' ? 'active' : '' %>">Reset password</a></li>
    <% } %>
    <% if (nav.district) { %>
      <li><a href="/admin/org" class="<%= nav.path === '/admin/org' ? 'active' : '' %>">Sites &amp; assignments</a></li>
      <li><a href="/admin/backup">Backup</a></li>
    <% } %>
    <li><a href="/logout" class="signout">Log out</a></li>
  </ul>
</nav>
