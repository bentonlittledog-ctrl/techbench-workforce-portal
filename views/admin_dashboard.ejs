<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Admin dashboard</h1>
    <p class="sub">Accounts and shifts for the sites and programs you manage.</p>

    <%- include('partials/clock_card') %>

    <% if (canAdd) { %>
    <div class="grid2">
        <details class="panel">
            <summary>Add an account</summary>
            <form action="/admin/users/add" method="POST">
                <label for="name">Full legal name</label>
                <input type="text" id="name" name="name" required>
                <label for="username">Username</label>
                <input type="text" id="username" name="username" autocapitalize="none" required>
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
                <label for="hourly_rate">Hourly rate ($/hr)</label>
                <input type="number" id="hourly_rate" name="hourly_rate" step="0.01" required>

                <label for="siteSelect">School / location</label>
                <select id="siteSelect" name="site_id">
                    <option value="">Choose school / location</option>
                </select>
                <label for="programSelect">Activity / program</label>
                <select id="programSelect" name="program_id">
                    <option value="">Choose a school first</option>
                </select>
                <script type="application/json" id="unitData"><%- JSON.stringify(units.map(u => ({ site_id: u.site_id, program_id: u.program_id, label: u.label }))).replace(/</g, '\\u003c') %></script>

                <% if (isDistrict) { %>
                    <label for="roleSelect">Role</label>
                    <select id="roleSelect" name="is_admin" required>
                        <option value="0">Employee (timesheet only)</option>
                        <option value="1">Location Coordinator (oversees the school / program chosen above)</option>
                        <option value="3">Student General Manager (head student of the program chosen above)</option>
                        <option value="4">Student Manager (limited, for the program chosen above)</option>
                        <option value="2">District administrator (everything, no site needed)</option>
                    </select>
                <% } else { %>
                    <input type="hidden" name="is_admin" value="0">
                    <p class="hint" style="margin-top:14px;">New accounts you add are employees in the site / program above.</p>
                <% } %>
                <button type="submit" class="wide">Save account</button>
            </form>
        </details>

        <details class="panel">
            <summary>Remove an account</summary>
            <form action="/admin/users/remove" method="POST">
                <label for="removeSelect">Account</label>
                <select id="removeSelect" name="employeeId" required>
                    <option value="">Choose an account</option>
                    <% users.forEach(user => { %>
                        <option value="<%= user.id %>"><%= user.name %> (<%= user.username %>) - <%= user.is_district ? 'District administrator' : (user.is_admin ? 'Supervising' : 'Employee') %></option>
                    <% }) %>
                </select>
                <p class="hint" style="margin-top:12px;">This permanently deletes the account and its timecards.</p>
                <button type="submit" class="btn-danger wide" onclick="return confirm('Permanently delete this account and all of its timecards?');">Delete account</button>
            </form>
        </details>
    </div>
    <% } %>

    <h3>Shifts</h3>
    <div class="row" style="margin-bottom:6px;">
        <div>
            <label for="employeeFilter">Filter by employee</label>
            <select id="employeeFilter" onchange="applyMatrixFilter()">
                <option value="ALL">Everyone</option>
                <% const names = [...new Set(shifts.map(s => s.name))]; names.forEach(empName => { %>
                    <option value="<%= empName %>"><%= empName %></option>
                <% }) %>
            </select>
        </div>
    </div>

    <div class="table-wrap">
    <table>
        <thead>
            <tr><th>Employee</th><% if (seePay) { %><th class="num">Rate</th><% } %><th>Date</th><th>Time</th><th class="num">Hours</th><% if (seePay) { %><th class="num">Amount</th><% } %></tr>
        </thead>
        <tbody id="timesheetBody">
            <% shifts.forEach(shift => { %>
                <tr data-name="<%= shift.name %>">
                    <td><%= shift.name %></td>
                    <% if (seePay) { %><td class="num">$<%= parseFloat(shift.rate).toFixed(2) %></td><% } %>
                    <td><%= shift.date %></td>
                    <td class="mono"><%= shift.time %></td>
                    <td class="num" data-h><%= parseFloat(shift.hours).toFixed(2) %></td>
                    <% if (seePay) { %><td class="num" data-p>$<%= parseFloat(shift.amount).toFixed(2) %></td><% } %>
                </tr>
            <% }) %>
            <% if (!shifts.length) { %><tr><td colspan="<%= seePay ? 6 : 4 %>" class="empty">No completed shifts yet.</td></tr><% } %>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="<%= seePay ? 4 : 3 %>">Total</td>
                <td class="num" id="totalHoursCell"><%= totalHours %></td>
                <% if (seePay) { %><td class="num" id="totalPayoutCell">$<%= totalPayout %></td><% } %>
            </tr>
        </tfoot>
    </table>
    </div>

    <script>
        (function () {
            const unitEl = document.getElementById("unitData");
            if (!unitEl) return;
            const units = JSON.parse(unitEl.textContent);
            const siteSel = document.getElementById("siteSelect");
            const progSel = document.getElementById("programSelect");
            const sites = new Map();
            units.forEach(u => sites.set(u.site_id, u.label.split(" / ")[0]));
            sites.forEach((label, id) => {
                const o = document.createElement("option");
                o.value = id; o.textContent = label;
                siteSel.appendChild(o);
            });
            siteSel.addEventListener("change", () => {
                progSel.innerHTML = "";
                const first = document.createElement("option");
                first.value = ""; first.textContent = siteSel.value ? "Choose activity / program" : "Choose a school first";
                progSel.appendChild(first);
                units.filter(u => String(u.site_id) === siteSel.value).forEach(u => {
                    const o = document.createElement("option");
                    o.value = u.program_id;
                    o.textContent = u.label.split(" / ").slice(1).join(" / ");
                    progSel.appendChild(o);
                });
            });
        })();

        function applyMatrixFilter() {
            const selector = document.getElementById("employeeFilter").value;
            let hours = 0, payout = 0;
            document.querySelectorAll("#timesheetBody tr[data-name]").forEach(row => {
                const show = selector === "ALL" || row.getAttribute("data-name") === selector;
                row.style.display = show ? "" : "none";
                if (show) {
                    const h = row.querySelector("[data-h]"), pc = row.querySelector("[data-p]");
                    hours += h ? parseFloat(h.textContent) || 0 : 0;
                    payout += pc ? parseFloat(pc.textContent.replace("$", "")) || 0 : 0;
                }
            });
            document.getElementById("totalHoursCell").textContent = hours.toFixed(2);
            const pt = document.getElementById("totalPayoutCell"); if (pt) pt.textContent = "$" + payout.toFixed(2);
        }
    </script>
</body>
</html>
