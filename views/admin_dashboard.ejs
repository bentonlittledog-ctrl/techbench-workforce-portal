<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Timesheet Transcriber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/water.css@2/out/water.css">
    <style>
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #455a64; padding: 10px; text-align: center; }
        th { background-color: #202b36; font-weight: bold; text-transform: uppercase; }
        .admin-box { background: #202b36; padding: 15px; border-radius: 6px; border: 1px solid #455a64; margin-bottom: 20px; }
    </style>
</head>
<body>
    <header style="display: flex; justify-content: space-between; align-items: center;">
        <h2>Administrative Operations: <%= name %></h2>
        <a href="/logout"><button style="background-color: #6c757d;">Log Out</button></a>
    </header>
    <p><a href="/admin/requests">Pending hour requests</a> | <a href="/timecards">Past timecards</a></p>
    <p><a href="/admin/users/reset">Reset a password</a><% if (isDistrict) { %> | <a href="/admin/org">Sites, programs and assignments</a> | <a href="/admin/backup">Download database backup</a><% } %></p>

    <!-- User Management Operations Center Panel -->
    <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px;">
        <!-- Form A: Add User Profile Account -->
        <div class="admin-box" style="flex: 1; min-width: 280px;">
            <h3>Add User Profile Account</h3>
            <form action="/admin/users/add" method="POST">
                <input type="text" name="name" placeholder="Full Legal Name" required style="margin-bottom:10px; width:100%;">
                <input type="text" name="username" placeholder="Username" required style="margin-bottom:10px; width:100%;">
                <input type="password" name="password" placeholder="Password" required style="margin-bottom:10px; width:100%;">
                <input type="number" name="hourly_rate" step="0.01" placeholder="Hourly Rate ($/hr)" required style="margin-bottom:10px; width:100%;">

                <label for="unitSelect" style="font-weight: bold; font-size: 0.95em; display: block; margin-top: 15px; margin-bottom: 6px; color: #fff;">
                    Site / Program:
                </label>
                <select id="unitSelect" name="unit" style="width: 100%; padding: 10px; margin-bottom: 10px; background-color: #161f27; color: #fff; border: 1px solid #455a64; border-radius: 4px; font-size: 1em;">
                    <option value="">-- Choose site / program --</option>
                    <% units.forEach(u => { %>
                        <option value="<%= u.value %>"><%= u.label %></option>
                    <% }) %>
                </select>

                <% if (isDistrict) { %>
                    <label for="roleSelect" style="font-weight: bold; font-size: 0.95em; display: block; margin-top: 15px; margin-bottom: 6px; color: #fff;">
                        Assign System Security Role:
                    </label>
                    <select id="roleSelect" name="is_admin" required style="width: 100%; padding: 10px; margin-bottom: 20px; background-color: #161f27; color: #fff; border: 1px solid #455a64; border-radius: 4px; font-size: 1em;">
                        <option value="0">Regular Staff Worker (Timesheet Only)</option>
                        <option value="1">Manager (manages the site / program chosen above)</option>
                        <option value="2">District Administrator (everything; no site needed)</option>
                    </select>
                <% } else { %>
                    <input type="hidden" name="is_admin" value="0">
                    <p style="font-size: 0.9em;">New accounts you add are regular staff in the site / program above.</p>
                <% } %>

                <button type="submit" style="background-color: #2ea44f; width:100%; font-weight: bold;">Save New Roster Account</button>
            </form>
        </div>

        <!-- Form B: Terminate/Remove User Profile Account -->
        <div class="admin-box" style="flex: 1; min-width: 280px;">
            <h3>Remove User Account Profile</h3>
            <form action="/admin/users/remove" method="POST">
                <label for="removeSelect">Select Account to Delete:</label>
                <select id="removeSelect" name="employeeId" required style="margin-bottom:15px; width:100%;">
                    <option value="">-- Choose Account to Terminate --</option>
                    <% users.forEach(user => { %>
                        <option value="<%= user.id %>">
                            <%= user.name %> (<%= user.username %>) (<%= user.is_district ? 'District Administrator' : (user.is_admin ? 'Manager' : 'Regular Staff Worker') %>)
                        </option>
                    <% }) %>
                </select>
                <button type="submit" style="background-color: #cb2431; width:100%; font-weight: bold; padding: 12px; border-radius: 4px; border: none; color: #fff;">
                    Permanently Delete User Profile
                </button>
            </form>
        </div>
    </div>

    <hr style="border-color: #455a64; margin: 30px 0;">

    <h3>Digital Paysheet Transcription View</h3>

    <!-- Filter Dropdown Selection Matrix Form Tool -->
    <div style="margin-bottom: 20px;">
        <label for="employeeFilter" style="font-weight: bold; margin-right: 10px;">Filter View by Employee:</label>
        <select id="employeeFilter" onchange="applyMatrixFilter()" style="max-width: 300px; background-color: #202b36; color: #fff;">
            <option value="ALL">-- Show Entire Company Records --</option>
            <% const names = [...new Set(shifts.map(s => s.name))]; names.forEach(empName => { %>
                <option value="<%= empName %>"><%= empName %></option>
            <% }) %>
        </select>
    </div>

    <table>
        <thead>
            <tr>
                <th>Work-Describe</th>
                <th>Hourly-Rate</th>
                <th>Date</th>
                <th>Time (Punch Span)</th>
                <th>HOURS-Worked</th>
                <th>Amount($)</th>
            </tr>
        </thead>
        <tbody id="timesheetBody">
            <% shifts.forEach(shift => { %>
                <tr data-name="<%= shift.name %>">
                    <td><strong>GHS Tech Bench (<%= shift.name %>)</strong></td>
                    <td>$<%= parseFloat(shift.rate).toFixed(2) %></td>
                    <td><%= shift.date %></td>
                    <td style="color: #8a99ad;"><%= shift.time %></td>
                    <td style="font-weight: bold; color: #f1c40f;"><%= parseFloat(shift.hours).toFixed(2) %> hrs</td>
                    <td style="font-weight: bold; color: #2ecc71;">$<%= parseFloat(shift.amount).toFixed(2) %></td>
                </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr style="background-color: #1a242f; font-weight: bold; border-top: 2px solid #455a64;">
                <td colspan="4" style="text-align: right; text-transform: uppercase; padding-right: 20px;">
                    <strong>Grand Totals Due:</strong>
                </td>
                <td id="totalHoursCell" style="color: #f1c40f; font-size: 1.1em;"><%= totalHours %> hrs</td>
                <td id="totalPayoutCell" style="color: #2ecc71; font-size: 1.1em;">$<%= totalPayout %></td>
            </tr>
        </tfoot>
    </table>

    <!-- Client-side Interactive Filter Script -->
    <script>
        function applyMatrixFilter() {
            const selector = document.getElementById("employeeFilter").value;
            const rows = document.querySelectorAll("#timesheetBody tr");
            let calculatedHours = 0;
            let calculatedPayout = 0;

            rows.forEach(row => {
                const rowName = row.getAttribute("data-name");

                // Pull true numbers straight from text data cells
                const hoursVal = parseFloat(row.cells[4].textContent) || 0;
                const payoutVal = parseFloat(row.cells[5].textContent.replace('$', '')) || 0;

                if (selector === "ALL" || rowName === selector) {
                    row.style.display = ""; // Show
                    calculatedHours += hoursVal;
                    calculatedPayout += payoutVal;
                } else {
                    row.style.display = "none"; // Hide
                }
            });

            // Update footer totals calculation dynamically
            document.getElementById("totalHoursCell").textContent = calculatedHours.toFixed(2) + " hrs";
            document.getElementById("totalPayoutCell").textContent = "$" + calculatedPayout.toFixed(2);
        }
    </script>
</body>
</html>
