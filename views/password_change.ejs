<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change password - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Change password</h1>
    <% if (first) { %><div class="msg bad" role="alert"><%= (typeof expired !== 'undefined' && expired) ? 'Your password is more than 3 months old. Choose a new one to continue.' : 'You are using a temporary, starter or expired password. Choose your own new password to continue.' %></div><% } %>
    <% if (error) { %><div class="msg bad" role="alert"><%= error %></div><% } %>
    <% if (ok) { %><div class="msg ok" role="status"><%= ok %></div><% } %>
    <form class="panel" action="/profile/password" method="POST" style="max-width:480px">
        <label for="current">Current password</label>
        <input type="password" id="current" name="current" autocomplete="current-password" required>
        <label for="password">New password (at least 8 characters)</label>
        <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
        <label for="confirm">New password again</label>
        <input type="password" id="confirm" name="confirm" minlength="8" maxlength="72" autocomplete="new-password" required>
        <p class="hint" style="margin-top:6px;">Pick something you will remember but others would not guess. Do not reuse your username. Passwords must be changed every 3 months, and a new one can't match your last 2 passwords.</p>
        <button type="submit">Change password</button>
    </form>
    <p class="hint"><a href="/profile">&larr; Back to my profile</a></p>
</body>
</html>
