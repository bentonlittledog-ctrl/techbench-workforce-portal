<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certifications - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Certifications</h1>
    <p class="sub">Who holds which certification. <%= admin ? 'Click a box to award a certification, or click a check to remove it.' : 'Managers award certifications.' %></p>
    <% if (flash) { %><div class="msg <%= flash.bad ? 'bad' : 'ok' %>" role="status"><%= flash.msg %></div><% } %>

    <div class="panel">
        <h3>My certifications</h3>
        <% if (myMissing.length) { %><div class="msg bad" style="margin-bottom:10px"><strong>You still need:</strong> <%= required.filter(c => myMissing.includes(c.short)).map(c => c.name).join(', ') %>. Every student must earn these.</div><% } %>
        <% if (!mine.length) { %><p class="hint">None yet. Ask your manager what you need to earn your first one.</p><% } else { %>
        <div class="chips"><% mine.forEach(m => { %><span class="badge ok" title="Awarded <%= m.when %><%= m.by ? ' by ' + m.by : '' %>">&#10003; <%= m.name %></span><% }) %></div>
        <% } %>
    </div>

    <% if (guidesOk) { %>
    <div class="panel">
        <h3>Certification guides</h3>
        <p class="hint">How to earn each certification: what to study, the skills checklist, the practice log, the knowledge check and the practical exam.</p>
        <div class="table-wrap"><table>
            <tbody><% guides.forEach(gd => { %><tr>
                <td><strong><%= gd.title %></strong><br><span class="hint"><%= gd.desc %></span></td>
                <td style="white-space:nowrap"><a href="/learn/pdf/<%= gd.file %>" target="_blank" rel="noopener">Open guide</a><% if (admin) { %> &middot; <a href="/learn/pdf/<%= gd.key %>" target="_blank" rel="noopener">Evaluator key</a><% } %></td>
            </tr><% }) %></tbody>
        </table></div>
        <% if (admin) { %><p class="hint">Evaluator keys contain the answers and are only shown to managers.</p><% } %>
    </div>
    <% } %>

    <% const backQs = (programId ? '?program=' + programId : '') + (q ? (programId ? '&' : '?') + 'q=' + encodeURIComponent(q) : ''); %>
    <div class="panel">
        <form action="/certifications" method="GET" class="searchbar certfilter">
            <% if (admin) { %>
            <select name="program" aria-label="Program" onchange="this.form.submit()">
                <option value="0">Everyone I manage</option>
                <% programs.forEach(p => { %><option value="<%= p.id %>" <%= p.id === programId ? 'selected' : '' %>><%= p.name %></option><% }) %>
            </select>
            <% } %>
            <input type="search" name="q" value="<%= q %>" placeholder="Find a person" maxlength="60" aria-label="Find a person">
            <label class="onlymiss"><input type="checkbox" name="missing" value="1" <%= onlyMissing ? 'checked' : '' %> onchange="this.form.submit()"> Only students missing a required one</label>
            <button type="submit">Filter</button>
        </form>
        <% if (students) { %><p class="hint" style="margin-top:-4px"><strong><%= complete %> of <%= students %></strong> students shown have all required certifications (<%= required.map(c => c.short).join(', ') %>).</p><% } %>
        <% if (!rows.length) { %><p class="hint">Nobody to show.</p><% } else { %>
        <div class="table-wrap"><table class="certtbl">
            <thead>
                <tr><th rowspan="2">Person</th><% groups.forEach(g => { %><th colspan="<%= g.n %>" class="c grp <%= g.name === 'Required' ? 'req' : '' %>"><%= g.name === 'Required' ? 'Required for every student' : g.name %></th><% }) %></tr>
                <tr><% certs.forEach(c => { %><th class="c <%= c.required ? 'req' : '' %>" title="<%= c.name %>"><%= c.short %></th><% }) %></tr>
            </thead>
            <tbody><% rows.forEach(p => { %><tr>
                <td><%= p.name %><% if (p.student) { %><br><span class="need <%= p.missing.length ? '' : 'done' %>" id="need-<%= p.id %>"><%= p.missing.length ? 'Needs: ' + p.missing.join(', ') : 'All required ✓' %></span><% } %></td>
                <% certs.forEach(c => { const h = p.held.get(c.key); const tip = h ? c.name + ' — awarded ' + String(h.awarded_at || '').slice(0, 10) + (h.awarded_name ? ' by ' + h.awarded_name : '') + (h.note ? ' (' + h.note + ')' : '') : c.name + ' — not held'; %>
                <td class="c <%= c.required ? 'reqcol' : '' %>"><% if (p.editable) { %><form action="/certifications/toggle" method="POST" style="margin:0" class="certtoggle" data-cert="<%= c.name %>" data-person="<%= p.name %>" data-id="<%= p.id %>"<% if (h) { %> onsubmit="return confirm('Remove <%= c.name %> from <%= p.name.replace(/'/g, '') %>?')"<% } %>>
                    <input type="hidden" name="employee" value="<%= p.id %>"><input type="hidden" name="cert" value="<%= c.key %>"><input type="hidden" name="back" value="<%= backQs %>">
                    <button type="submit" class="cellbtn btn-ghost <%= h ? 'on' : '' %>" title="<%= tip %>" aria-label="<%= c.name %> for <%= p.name %>: <%= h ? 'held, click to remove' : 'not held, click to award' %>"><%= h ? '✓' : '' %></button></form>
                <% } else { %><span class="cellbtn <%= h ? 'on' : '' %>" title="<%= tip %>"><%= h ? '✓' : '' %></span><% } %></td>
                <% }) %>
            </tr><% }) %></tbody>
        </table></div>
        <% } %>
    </div>

    <div class="panel">
        <h3>What each certification means</h3>
        <div class="table-wrap"><table>
            <thead><tr><th>Certification</th><th>Means</th><th class="c">Holders shown</th></tr></thead>
            <tbody><% certs.forEach(c => { %><tr><td><strong><%= c.name %></strong><% if (c.required) { %> <span class="badge warn">Required</span><% } %></td><td><%= c.desc %></td><td class="c"><%= counts[c.key] %></td></tr><% }) %></tbody>
        </table></div>
        <p class="hint">Tier 1, 2 and 3 also decide which repair guides open: a guide marked for Tier 3 opens only for people with Tier 3. Managers can open every guide.</p>
    </div>
<style>
.certtbl th.c,.certtbl td.c{text-align:center;padding-left:4px;padding-right:4px}
.certtbl thead tr:last-child th{white-space:normal;max-width:76px;line-height:1.2;font-size:13px}
.certtbl th.grp{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.certtbl td:first-child{white-space:nowrap}
.certfilter{margin-bottom:14px}
.certfilter select{width:auto;min-width:200px}
.cellbtn{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;border:1px solid var(--line,#cbd5e1);background:transparent;padding:0;margin:0;font-weight:700;color:var(--accent,#12843f);cursor:pointer}
span.cellbtn{cursor:default}
.cellbtn.on{background:var(--accent-soft,#dcfce7);border-color:var(--accent,#12843f)}
</style>
<div id="certToast" class="msg ok" role="status" aria-live="polite" hidden></div>
<script>
// Award or remove without reloading, so the page stays where you are.
(function () {
    var toast = document.getElementById('certToast'), timer;
    function show(msg, bad) {
        toast.textContent = msg; toast.className = 'msg ' + (bad ? 'bad' : 'ok'); toast.hidden = false;
        clearTimeout(timer); timer = setTimeout(function () { toast.hidden = true; }, 3500);
    }
    document.querySelectorAll('form.certtoggle').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;              // "Remove?" was cancelled
            e.preventDefault();
            var btn = form.querySelector('button');
            if (btn.disabled) return;
            btn.disabled = true;
            fetch(form.action, { method: 'POST', credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' }, body: new URLSearchParams(new FormData(form)) })
                .then(function (r) { return r.json().catch(function () { throw new Error('bad'); }); })
                .then(function (d) {
                    btn.disabled = false;
                    if (!d.ok) { show(d.msg || 'That did not save.', true); return; }
                    btn.classList.toggle('on', d.held);
                    btn.textContent = d.held ? '\u2713' : '';
                    btn.title = d.tip;
                    btn.setAttribute('aria-label', form.dataset.cert + ' for ' + form.dataset.person + ': ' + (d.held ? 'held, click to remove' : 'not held, click to award'));
                    form.onsubmit = d.held ? function () { return confirm('Remove ' + form.dataset.cert + ' from ' + form.dataset.person + '?'); } : null;
                    var need = document.getElementById('need-' + form.dataset.id);
                    if (need && d.missing) { need.textContent = d.missing.length ? 'Needs: ' + d.missing.join(', ') : 'All required \u2713'; need.classList.toggle('done', !d.missing.length); }
                    show(d.msg);
                })
                .catch(function () { btn.disabled = false; form.submit(); });   // fall back to the normal page reload
        });
    });
})();
</script>
<style>.need{font-size:12px;font-weight:600;color:var(--bad,#A33A2F)}.need.done{color:var(--ok,#2F7A4B)}
.certtbl th.req{color:var(--warn,#B7791F)}.certtbl td.reqcol{background:rgba(183,121,31,.06)}
.onlymiss{display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:14px;margin:0}.onlymiss input{width:auto;margin:0}
#certToast{position:fixed;right:20px;bottom:20px;z-index:50;max-width:360px;box-shadow:0 6px 24px rgba(0,0,0,.18)}</style>
</body>
</html>
