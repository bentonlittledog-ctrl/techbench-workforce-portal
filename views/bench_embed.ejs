<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Timecard Portal</title>
    <%- headTags %>
    <style>
        .tabbar{display:flex;gap:8px;margin:0 0 14px;flex-wrap:wrap}.tabbar .btn{margin-top:0}
        .embedframe{width:100%;height:82vh;min-height:620px;border:0;border-radius:10px;background:transparent}
    </style>
</head>
<body>
    <%- include('partials/nav') %>
    <h1><%= title %></h1>
    <p class="sub">Fills in the master administrative sheet directly. Sign in with your district Google account if asked.</p>
    <div class="tabbar">
        <a class="btn <%= page === 'order' ? 'btn-primary' : 'btn-ghost' %>" href="/bench/order">Order a part</a>
        <a class="btn <%= page === 'repair' ? 'btn-primary' : 'btn-ghost' %>" href="/bench/repair">Log a repair</a>
        <a class="btn btn-ghost" href="<%= openUrl %>" target="_blank" rel="noopener">Open in a new tab</a>
    </div>
    <div id="tk" class="msg ok" role="status" hidden></div>
    <iframe id="gf" class="embedframe" src="about:blank" data-src="<%= src %>" title="<%= title %>" referrerpolicy="no-referrer"></iframe>
    <p class="sub">Form blank or asking you to sign in? Use <strong>Open in a new tab</strong> above.</p>
<script>
(function () {
    function hex(v, fb) {
        var t = document.createElement('span'); t.style.color = v || fb; document.body.appendChild(t);
        var m = getComputedStyle(t).color.match(/\d+(\.\d+)?/g) || [0, 0, 0]; t.remove();
        return m.slice(0, 3).map(function (n) { return ('0' + Math.round(+n).toString(16)).slice(-2); }).join('');
    }
    function cv(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
    var f = document.getElementById('gf');
    var bg = getComputedStyle(document.body).backgroundColor;
    var q = '&bg=' + hex(bg, '#ffffff') + '&surf=' + hex(cv('--surface'), bg) + '&fg=' + hex(cv('--text'), '#111111') +
            '&muted=' + hex(cv('--muted'), '#667085') + '&line=' + hex(cv('--line'), '#d9dfe9');
    f.style.background = bg;
    f.src = f.getAttribute('data-src') + q + '&po=' + encodeURIComponent(location.origin);
    <% if (page === 'repair') { %>
    // The form reports a saved repair; turn it into a ticket in the repair queue.
    window.addEventListener('message', function (ev) {
        if (!/^https:\/\/([a-z0-9-]+\.)*(googleusercontent|google)\.com$/i.test(ev.origin)) return;
        var d = ev.data; if (!d || d.type !== 'tb-repair-logged') return;
        var b = new URLSearchParams();
        ['model', 'serial', 'complaint', 'parts', 'tier', 'notes', 'student_first', 'student_last', 'student_id', 'student_grade'].forEach(function (k) { b.set(k, d[k] == null ? '' : String(d[k])); });
        b.set('client_ref', String(d.ref || '')); b.set('sheet_row', String(d.row || ''));
        var box = document.getElementById('tk');
        fetch('/bench/queue/from-form', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: b.toString() })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                box.hidden = false; box.className = 'msg' + (j && j.ok ? ' ok' : ' bad'); box.textContent = '';
                if (j && j.ok) { box.append('Saved to the sheet and added to the repair queue as '); var a = document.createElement('a'); a.href = '/bench/ticket?id=' + j.id; a.textContent = 'ticket #' + j.id; box.append(a, '.'); }
                else box.textContent = 'Saved to the sheet, but the repair queue could not add it' + (j && j.error ? ': ' + j.error : '.') + ' Use New ticket in the queue.';
            })
            .catch(function () { box.hidden = false; box.className = 'msg bad'; box.textContent = 'Saved to the sheet, but the repair queue could not be reached. Use New ticket in the queue.'; });
    });
    <% } %>
})();
</script>
</body>
</html>
