<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bench dashboard - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Bench dashboard</h1>
    <p class="sub">Where the repair queue stands right now, and how the bench has been doing. Print this page to share it.</p>
    <% if (flash) { %><div class="msg <%= flash.bad ? 'bad' : 'ok' %>" role="status"><%= flash.msg %></div><% } %>

    <div class="cards">
        <a class="card" href="/bench/queue"><div class="big"><%= cards.open %></div><div class="lbl">Open tickets</div></a>
        <a class="card ok" href="/bench/queue?view=ready"><div class="big"><%= cards.ready %></div><div class="lbl">Ready for pickup</div></a>
        <a class="card <%= cards.stuck ? 'warn' : '' %>" href="/bench/queue?flag=stuck"><div class="big"><%= cards.stuck %></div><div class="lbl">Stuck <%= stuckDays %>+ days</div></a>
        <a class="card <%= cards.unassigned ? 'bad' : '' %>" href="/bench/queue?assignee=none"><div class="big"><%= cards.unassigned %></div><div class="lbl">Unassigned</div></a>
        <a class="card" href="/bench/queue?priority=High"><div class="big"><%= cards.high %></div><div class="lbl">High priority</div></a>
        <a class="card <%= cards.repeatOpen ? 'warn' : '' %>" href="/bench/queue?flag=repeat"><div class="big"><%= cards.repeatOpen %></div><div class="lbl">Repeat devices open</div></a>
    </div>

    <div class="panel">
        <h3>Open tickets by status</h3>
        <div class="bars">
            <% byStatus.forEach(x => { %>
                <div class="bar"><span><a href="/bench/queue?status=<%= encodeURIComponent(x.status) %>"><%= x.status %></a></span><span class="track"><span class="fill <%= x.tone %>" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.n %></span></div>
            <% }) %>
        </div>
    </div>

    <div class="rangebar" aria-label="Time range">
        <span class="dim" style="align-self:center">Opened in the last:</span>
        <% [['30','30 days'],['90','90 days'],['365','Year'],['all','All time']].forEach(r => { %><a class="<%= range === r[0] ? 'on' : '' %>" href="/bench/dashboard?range=<%= r[0] %>"><%= r[1] %></a><% }) %>
    </div>

    <div class="cards">
        <div class="card"><div class="big"><%= opened %></div><div class="lbl">Tickets opened</div></div>
        <div class="card"><div class="big"><%= avgDays == null ? '—' : avgDays %></div><div class="lbl">Average days to repair<%= finished ? ' (' + finished + ' repairs)' : '' %></div></div>
        <div class="card"><div class="big"><%= medianDays == null ? '—' : medianDays %></div><div class="lbl">Median days to repair</div></div>
        <div class="card"><div class="big"><%= unrepairable %></div><div class="lbl">Unrepairable</div></div>
    </div>

    <div class="grid2">
        <div class="panel">
            <h3>Repairs by tier</h3>
            <div class="bars">
                <% tierRows.forEach(x => { %>
                    <div class="bar"><span><%= x.n ? 'Tier ' + x.n + ' - ' + x.name : 'Tier not set' %></span><span class="track"><span class="fill" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.count %></span></div>
                <% }) %>
            </div>
        </div>
        <div class="panel">
            <h3>Repairs by school</h3>
            <% if (!schools.length) { %><p class="hint">No tickets in this range.</p><% } %>
            <div class="bars">
                <% schools.forEach(x => { %>
                    <div class="bar"><span><%= x.name %></span><span class="track"><span class="fill" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.count %></span></div>
                    <div class="dim" style="font-size:12px;margin:-4px 0 4px"><%= x.open %> open<%= x.avgDays != null ? ' · avg ' + x.avgDays + ' days to repair' : '' %></div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="grid2">
        <div class="panel">
            <h3>Who has the most open tickets</h3>
            <% if (!mostOpen.length) { %><p class="hint">Nothing open.</p><% } %>
            <div class="bars">
                <% mostOpen.forEach(x => { %>
                    <div class="bar"><span><%= x.name %></span><span class="track"><span class="fill <%= x.name === 'Unassigned' ? 'bad' : '' %>" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.n %></span></div>
                <% }) %>
            </div>
            <p style="margin:12px 0 0"><a href="/bench/workload">See each person's tickets &rarr;</a></p>
        </div>
        <div class="panel">
            <h3>Most repaired models</h3>
            <% if (!models.length) { %><p class="hint">No tickets in this range.</p><% } %>
            <div class="bars">
                <% models.forEach(x => { %>
                    <div class="bar"><span><%= x.name %></span><span class="track"><span class="fill" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.n %></span></div>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="panel">
        <h3>Tickets opened per week</h3>
        <div class="bars">
            <% weekRows.forEach(x => { %>
                <div class="bar"><span>Week of <%= x.week %></span><span class="track"><span class="fill" style="display:block;width:<%= x.w %>%"></span></span><span class="num"><%= x.n %></span></div>
            <% }) %>
        </div>
    </div>

    <div class="panel">
        <h3>Devices that keep coming back</h3>
        <% if (!repeatDevices.length) { %><p class="hint">No device has been in more than once.</p><% } else { %>
        <div style="overflow-x:auto"><table>
            <thead><tr><th>Device</th><th>Serial / asset ID</th><th>Times in</th><th>Last in</th><th></th></tr></thead>
            <tbody>
            <% repeatDevices.forEach(d => { %>
                <tr><td><%= d.model %></td><td><%= d.serial %></td><td><span class="pill <%= d.n >= 3 ? 'bad' : 'warn' %>">&times;<%= d.n %></span></td><td><%= d.last %></td>
                    <td><a href="/bench/ticket?id=<%= d.lastId %>">Latest ticket</a><%= d.open ? ' · still open' : '' %></td></tr>
            <% }) %>
            </tbody>
        </table></div>
        <% } %>
    </div>
</body>
</html>
