<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit timecards - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Edit timecards</h1>
    <p class="sub">Add, change or delete shifts. Every change is saved to the audit log with your reason.</p>

    <% if (message) { %><div class="msg" role="status"><%= message %></div><% } %>

    <% if (!people.length) { %>
        <div class="panel">There are no employees in your areas yet.</div>
    <% } else { %>
    <form action="/admin/shifts" method="GET" class="row panel">
        <div>
            <label for="employeeId">Employee</label>
            <select id="employeeId" name="employeeId">
                <% people.forEach(p => { %>
                    <option value="<%= p.id %>" <%= p.id === empId ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label for="month">Month</label>
            <input type="month" id="month" name="month" value="<%= month %>">
        </div>
        <div style="flex:0 0 auto;"><button type="submit">View</button></div>
    </form>

    <h3 style="margin-top:8px;"><%= emp.name %> &middot; <%= monthLabel %></h3>

    <div class="stats">
        <div class="stat"><div class="k">Shifts</div><div class="v"><%= shifts.length %></div></div>
        <div class="stat"><div class="k">Hours</div><div class="v"><%= totalHours %></div></div>
        <div class="stat"><div class="k">Pay</div><div class="v">$<%= totalPay %></div></div>
    </div>

    <details class="panel">
        <summary>Add a shift</summary>
        <form action="/admin/shifts/add" method="POST">
            <input type="hidden" name="employeeId" value="<%= empId %>">
            <div class="row">
                <div><label for="addStart">Start</label><input type="datetime-local" id="addStart" name="start" required></div>
                <div><label for="addEnd">End</label><input type="datetime-local" id="addEnd" name="end" required></div>
            </div>
            <label for="addReason">Reason (kept in the audit log)</label>
            <input type="text" id="addReason" name="reason" maxlength="300" placeholder="e.g. Forgot to clock in, confirmed by supervisor" required>
            <button type="submit">Add shift</button>
        </form>
    </details>

    <div class="table-wrap">
    <table>
        <thead>
            <tr><th>Date</th><th>Time</th><th class="num">Hours</th><th class="num">Amount</th><th></th></tr>
        </thead>
        <tbody>
            <% shifts.forEach(s => { %>
                <tr>
                    <td><%= s.date %></td>
                    <td class="mono"><%= s.time %></td>
                    <td class="num"><%= s.hours %></td>
                    <td class="num">$<%= s.amount %></td>
                    <td class="r"><a href="/admin/shifts/edit?in=<%= s.inId %>&out=<%= s.outId %>">Edit or delete</a></td>
                </tr>
            <% }) %>
            <% if (!shifts.length) { %><tr><td colspan="5" class="empty">No completed shifts this month.</td></tr><% } %>
        </tbody>
        <tfoot>
            <tr><td colspan="2">Total</td><td class="num"><%= totalHours %></td><td class="num">$<%= totalPay %></td><td></td></tr>
        </tfoot>
    </table>
    </div>

    <% if (strays.length) { %>
        <h3>Punches without a match</h3>
        <p class="hint">These are a clock-in with no clock-out, or a clock-out with no clock-in. They don't count toward pay until fixed. Add the missing punch, or delete a mistaken one.</p>
        <div class="table-wrap">
        <table>
            <thead><tr><th>Punch</th><th>When</th><th>Fix</th></tr></thead>
            <tbody>
                <% strays.forEach(p => { %>
                    <tr>
                        <td><span class="badge warn"><%= p.action === 'CLOCK_IN' ? 'Clock in' : 'Clock out' %></span></td>
                        <td class="mono"><%= p.when %></td>
                        <td>
                            <form action="/admin/shifts/complete" method="POST">
                                <input type="hidden" name="punchId" value="<%= p.id %>">
                                <label>Add the missing <%= p.action === 'CLOCK_IN' ? 'clock-out' : 'clock-in' %> time</label>
                                <input type="datetime-local" name="time" required>
                                <input type="text" name="reason" maxlength="300" placeholder="Reason" required>
                                <button type="submit">Add</button>
                            </form>
                            <form action="/admin/shifts/punch-delete" method="POST">
                                <input type="hidden" name="punchId" value="<%= p.id %>">
                                <input type="text" name="reason" maxlength="300" placeholder="Reason for deleting" required>
                                <button type="submit" class="btn-danger">Delete punch</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
    <% } %>
    <% } %>
</body>
</html>
