<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Health check - Timecard Portal</title>
    <%- headTags %>
</head>
<body>
    <%- include('partials/nav') %>
    <h1>Health check</h1>
    <p class="sub">One screen to check the portal is looking after itself. Checked <%= now %>.</p>
    <div class="msg <%= bad ? 'bad' : warn ? '' : 'ok' %>" role="status"><%= bad ? bad + ' thing' + (bad === 1 ? '' : 's') + ' need attention.' : warn ? 'Working, with ' + warn + ' thing' + (warn === 1 ? '' : 's') + ' worth a look.' : 'Everything looks good.' %></div>
    <div class="panel">
        <div class="table-wrap"><table>
            <thead><tr><th>Check</th><th>Status</th><th>Details</th></tr></thead>
            <tbody><% checks.forEach(c => { %><tr><td><%= c.name %></td><td><span class="badge <%= c.state === 'ok' ? 'ok' : c.state === 'bad' ? 'bad' : 'warn' %>"><%= c.state === 'ok' ? 'OK' : c.state === 'bad' ? 'Fix' : 'Check' %></span></td><td><%= c.detail %></td></tr><% }) %></tbody>
        </table></div>
        <p class="hint">Need a copy off the server? <a href="/admin/backup">Download a backup</a>.</p>
    </div>

    <div class="panel">
        <h3>Passwords</h3>
        <% if (typeof pwJust !== 'undefined' && pwJust) { %><div class="msg ok" role="status">Done. All <%= pwJust %> accounts must choose a new password at their next page, including yours.</div><% } %>
        <p class="hint">Make everyone pick a new password. Each person is sent to the change-password page the next time they open anything, and can't continue until they choose a strong one that is different from the old one. <% if (typeof pwPending !== 'undefined') { %><strong><%= pwPending %></strong> account<%= pwPending === 1 ? '' : 's' %> currently waiting to change.<% } %></p>
        <form action="/admin/passwords/require-all" method="POST" style="margin:0"><button type="submit" onclick="return confirm('Make every account choose a new password at their next page? This includes you.');">Require everyone to change their password</button></form>
    </div>
</body>
</html>
